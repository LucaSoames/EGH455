# UAV Payload Tracking and Acquisition System (TAQ-25)
# Environment Configuration

# Database
DATABASE_URL=sqlite:///uav_payload.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost/uav_payload_db

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis Configuration (for real-time features)
REDIS_URL=redis://localhost:6379/0

# External API Keys (configure as needed)
WEATHER_API_KEY=your-weather-api-key
MAPS_API_KEY=your-maps-api-key

# UAV Configuration
DEFAULT_UAV_ALTITUDE=100
MAX_PAYLOAD_WEIGHT=25
COMMUNICATION_FREQUENCY=2.4

# Logging
LOG_LEVEL=INFO
LOG_FILE=uav_system.log
